# Copie para deploy/.env na VPS e preencha (os mesmos valores da Netlify).
# URL que o build usa para gerar as páginas. Troque para https://api.compendio-catolico.com/api quando
# o registro `api` existir na Cloudflare apontando para esta VPS (hoje ele não existe).
API_URL_PUBLICA=https://acervo-cat-lico-api-jqtz.onrender.com/api
NEXTAUTH_URL=https://compendio-catolico.com
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_SECRET=
INTERNAL_API_SECRET=
NEXT_PUBLIC_HIMETRICA_API_KEY=
