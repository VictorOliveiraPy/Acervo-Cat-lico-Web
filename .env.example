# URL base da API do acervo (inclui o prefixo /api).
# Sem prefixo NEXT_PUBLIC_: todo o fetch acontece em server components
# (ver lib/api.ts, lib/services/acervoService.ts) — nenhum componente
# client chama a API direto, então não precisa ir pro bundle do navegador.
API_URL=http://localhost:8000/api
