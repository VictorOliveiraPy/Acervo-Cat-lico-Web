# URL base da API do acervo (inclui o prefixo /api).
# Sem prefixo NEXT_PUBLIC_: todo o fetch acontece em server components
# (ver lib/api.ts, lib/services/acervoService.ts) — nenhum componente
# client chama a API direto, então não precisa ir pro bundle do navegador.
API_URL=http://localhost:8000/api

# Login com Google (opcional: sem AUTH_GOOGLE_ID, o botão de entrar não aparece).
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_SECRET=          # openssl rand -base64 32
# NEXTAUTH_URL=https://compendio-catolico.com
# INTERNAL_API_SECRET=  # o mesmo valor configurado na API

# Domínio próprio das imagens (opcional). Libera o host na CSP e no next/image; as
# URLs em si vêm da API (IMAGE_CDN_BASE_URL no backend).
# NEXT_PUBLIC_IMG_BASE_URL=https://img.compendio-catolico.com
